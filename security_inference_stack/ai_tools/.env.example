PUID=1000
PGID=1000
TZ=Europe/London
DOCKERCONFIGPATH=/mnt/apps/docker

# OpenViking persistent memory. Store all five values as Dockhand secrets.
# The historical Hermes identifiers are retained for data/client compatibility;
# Hermes uses the shared USER key only, never root/recovery keys or seeds.
OPENVIKING_ROOT_API_KEY=replace-with-64-random-hex-characters
OPENVIKING_HERMES_KEY_SEED=replace-with-64-random-hex-characters
OPENVIKING_API_KEY=derive-from-hermes-user-and-key-seed
OPENVIKING_CODEX_KEY_SEED=replace-with-64-random-hex-characters
OPENVIKING_CODEX_API_KEY=derive-from-codex-user-and-key-seed
# The VLM runs on OpenRouter. Free models are reasoning models, so the renderer
# sends reasoning.exclude to keep structured extraction clean.
OPENVIKING_VLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENVIKING_VLM_PROVIDER=openrouter
# Store as a Dockhand encrypted secret. Never commit a live key.
OPENROUTER_API_KEY=
# Embeddings stay local: OpenRouter's free tier caps at 50 requests/day and
# OpenViking issues roughly 2,900.
OPENVIKING_EMBED_MODEL=qwen3-embedding:0.6b
OPENVIKING_EMBED_DIMENSION=1024
OPENVIKING_CPUS=1.5
OPENVIKING_MEMORY_LIMIT=3g
OPENVIKING_OLLAMA_CPUS=1.0
OPENVIKING_OLLAMA_MEMORY_LIMIT=2g

# Playwright MCP owns its isolated browser and egresses directly.
PLAYWRIGHT_MCP_CPUS=1.25
PLAYWRIGHT_MCP_MEMORY_LIMIT=1536m



# Rusty IMAP MCP iCloud sidecar. Store this as a Dockhand secret.
RUSTY_IMAP_MCP_IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Hermes uses the retained /mnt/apps/docker/hermes auth/session store.
HERMES_CPUS=2.0
HERMES_MEMORY_LIMIT=4g
TERMINAL_SSH_USER=jellman86
HERMES_HOST_WORKDIR=/home/jellman86
# Store all dashboard values and HASS_TOKEN as encrypted Dockhand secrets.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HASS_TOKEN=
# Existing GitHub authorization; store only as an encrypted Dockhand secret.
HERMES_GITHUB_TOKEN=
