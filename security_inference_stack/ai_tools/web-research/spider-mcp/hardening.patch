diff --git a/spider_mcp/src/tools/mod.rs b/spider_mcp/src/tools/mod.rs
index 0967465..15e50d5 100644
--- a/spider_mcp/src/tools/mod.rs
+++ b/spider_mcp/src/tools/mod.rs
@@ -6,0 +7 @@ use spider::features::chrome_common::{WaitForDelay, WaitForIdleNetwork, WaitForS
+use spider::url::Url;
@@ -7,0 +9 @@ use spider::website::Website;
+use std::net::{IpAddr, Ipv4Addr};
@@ -9,0 +12,127 @@ use std::time::Duration;
+pub const MAX_URL_BYTES: usize = 2048;
+pub const MAX_SCRAPE_CONTENT_BYTES: usize = 131_072;
+pub const MAX_CRAWL_CONTENT_BYTES: usize = 32_768;
+pub const MAX_LINKS: usize = 100;
+pub const MAX_CRAWL_PAGES: u32 = 10;
+pub const MAX_CRAWL_DEPTH: usize = 3;
+const MAX_SELECTOR_BYTES: usize = 256;
+const MAX_PATTERN_BYTES: usize = 256;
+const MAX_PATTERNS: usize = 50;
+
+pub fn validate_public_url(input: &str) -> Result<String, String> {
+    if input.is_empty() || input.len() > MAX_URL_BYTES || input.chars().any(char::is_control) {
+        return Err("URL is empty, oversized, or contains control characters".to_string());
+    }
+
+    let parsed =
+        Url::parse(input).map_err(|_| "URL must be an absolute HTTP(S) URL".to_string())?;
+    if !matches!(parsed.scheme(), "http" | "https") {
+        return Err("Only HTTP and HTTPS URLs are allowed".to_string());
+    }
+    if !parsed.username().is_empty() || parsed.password().is_some() {
+        return Err("URL user information is not allowed".to_string());
+    }
+    if let Some(port) = parsed.port() {
+        if !matches!(port, 80 | 443) {
+            return Err("Only destination ports 80 and 443 are allowed".to_string());
+        }
+    }
+
+    let host = parsed
+        .host_str()
+        .ok_or_else(|| "URL must contain a host".to_string())?;
+    let normalized_host = host.trim_end_matches('.').to_ascii_lowercase();
+    if normalized_host == "localhost"
+        || normalized_host.ends_with(".localhost")
+        || normalized_host.ends_with(".local")
+        || normalized_host.ends_with(".internal")
+        || normalized_host.ends_with(".home.arpa")
+        || (!normalized_host.contains('.') && normalized_host.parse::<IpAddr>().is_err())
+    {
+        return Err("Local and internal hostnames are not allowed".to_string());
+    }
+    if let Ok(ip) = normalized_host.parse::<IpAddr>() {
+        if is_forbidden_ip(ip) {
+            return Err(
+                "Private, loopback, link-local, and special-use addresses are not allowed"
+                    .to_string(),
+            );
+        }
+    }
+
+    Ok(parsed.into())
+}
+
+fn forbidden_ipv4(ip: Ipv4Addr) -> bool {
+    let octets = ip.octets();
+    ip.is_private()
+        || ip.is_loopback()
+        || ip.is_link_local()
+        || ip.is_broadcast()
+        || ip.is_documentation()
+        || ip.is_multicast()
+        || ip.is_unspecified()
+        || octets[0] == 0
+        || octets[0] >= 240
+        || (octets[0] == 100 && (64..=127).contains(&octets[1]))
+        || (octets[0] == 192 && octets[1] == 0 && octets[2] == 0)
+        || (octets[0] == 198 && matches!(octets[1], 18 | 19))
+}
+
+fn is_forbidden_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => forbidden_ipv4(v4),
+        IpAddr::V6(v6) => {
+            v6.is_loopback()
+                || v6.is_unspecified()
+                || v6.is_multicast()
+                || v6.is_unique_local()
