@@ -11,0 +13,2 @@ use server::SpiderMcpServer;
+const SHARED_CHROME_ENDPOINT: &str = "http://spider-chromium:9222";
+
@@ -19,0 +23,42 @@ struct Cli {
+fn validate_chrome_websocket(value: &str) -> Result<String, String> {
+    let parsed = Url::parse(value).map_err(|_| "Chrome returned an invalid WebSocket URL")?;
+    if !matches!(parsed.scheme(), "ws" | "wss")
+        || parsed.host_str() != Some("spider-chromium")
+        || parsed.port_or_known_default() != Some(9222)
+        || !parsed.path().starts_with("/devtools/browser/")
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+    {
+        return Err("Chrome returned an unexpected WebSocket endpoint".to_string());
+    }
+    Ok(parsed.into())
+}
+
+async fn configure_shared_chrome() -> Result<(), String> {
+    let endpoint = std::env::var("SPIDER_CHROME_ENDPOINT")
+        .unwrap_or_else(|_| SHARED_CHROME_ENDPOINT.to_string());
+    if endpoint.trim_end_matches('/') != SHARED_CHROME_ENDPOINT {
+        return Err(
+            "SPIDER_CHROME_ENDPOINT must target the fixed Spider Chromium service".to_string(),
+        );
+    }
+
+    let response = spider::reqwest::get(format!("{SHARED_CHROME_ENDPOINT}/json/version"))
+        .await
+        .map_err(|_| "Could not reach the Spider Chromium service")?
+        .error_for_status()
+        .map_err(|_| "Spider Chromium returned an error")?;
+    let document: serde_json::Value = response
+        .json()
+        .await
+        .map_err(|_| "Spider Chromium returned invalid JSON")?;
+    let websocket = document
+        .get("webSocketDebuggerUrl")
+        .and_then(serde_json::Value::as_str)
+        .ok_or_else(|| "Spider Chromium did not return a WebSocket endpoint".to_string())?;
+    let websocket = validate_chrome_websocket(websocket)?;
+
+    std::env::set_var("CHROME_URL", websocket);
+    Ok(())
+}
+
@@ -28,0 +74,2 @@ async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    configure_shared_chrome().await?;
+
@@ -35,0 +83,24 @@ async fn main() -> Result<(), Box<dyn std::error::Error>> {
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn accepts_only_the_expected_shared_chrome_websocket() {
+        assert!(validate_chrome_websocket(
+            "ws://spider-chromium:9222/devtools/browser/12345678-1234-1234-1234-123456789abc"
+        )
+        .is_ok());
+        for value in [
+            "ws://127.0.0.1:9222/devtools/browser/id",
+            "ws://spider-chromium:9999/devtools/browser/id",
+            "ws://spider-chromium:9222/devtools/page/id",
+            "https://spider-chromium:9222/devtools/browser/id",
+        ] {
+            assert!(
+                validate_chrome_websocket(value).is_err(),
+                "accepted {value}"
+            );
+        }
+    }
+}
