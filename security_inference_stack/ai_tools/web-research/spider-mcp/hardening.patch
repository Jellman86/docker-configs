+pub fn bounded_content(mut content: String, max_bytes: usize) -> String {
+    if content.len() <= max_bytes {
+        return content;
+    }
+    let mut end = max_bytes;
+    while !content.is_char_boundary(end) {
+        end -= 1;
+    }
+    content.truncate(end);
+    content.push_str("\n\n[output truncated by AI tools web-research limits]");
+    content
+}
+
+pub fn bounded_links(mut links: Vec<String>) -> Vec<String> {
+    links.truncate(MAX_LINKS);
+    links
+        .into_iter()
+        .filter(|link| link.len() <= MAX_URL_BYTES)
+        .collect()
+}
