[Unit]
Description=Online home lab configuration and database backup
RequiresMountsFor=/mnt/services /mnt/tank /mnt/apps/docker
After=docker.service
ConditionPathExists=/etc/quark-app-backup.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/quark-app-backup
TimeoutStartSec=30min
Nice=15
UMask=0077
