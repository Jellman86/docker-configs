PUID=1000
PGID=1000
TZ=Europe/London
DOCKERCONFIGPATH=/mnt/apps/docker

# OpenKnowledge has no auth of its own and is reachable only on the private
# LAN/Tailscale through NPM. See openknowledge/README.md.
OPENKNOWLEDGE_VERSION=0.86.22
OPENKNOWLEDGE_EXTERNAL_URL=https://openknowledge.pownet.uk
OPENKNOWLEDGE_CPUS=1.0
OPENKNOWLEDGE_MEMORY_LIMIT=1g

# SearXNG secret key. Store as a Dockhand secret; never in settings.yml/Git.
SEARXNG_SECRET=
SEARXNG_BASE_URL=https://searxng.pownet.uk/
SEARXNG_CPUS=1.0
SEARXNG_MEMORY_LIMIT=1g

# Playwright MCP owns its isolated browser and egresses directly.
PLAYWRIGHT_MCP_CPUS=1.25
PLAYWRIGHT_MCP_MEMORY_LIMIT=1536m
